# Copy to .env and fill in. Never commit .env. A shared .env is fine:
# docker-compose.yml passes only the ARTHIK_* variables and TZ into the container.

# ---- host side (docker compose) ----------------------------------------------
# Folder with your data files (the demo is generated in <FINANCE_PATH>/demouser).
FINANCE_PATH=/path/to/notes/data/finance
# Server-only files (bans.json). Not synced. Create it, owned by PUID:PGID.
STATE_PATH=./state
# Run as this user so saved files belong to you (id -u; id -g).
PUID=1000
PGID=1000
# Docker network your reverse proxy is on.
ARTHIK_NETWORK=homelab
# Decides what "today" is.
TZ=Asia/Kolkata

# ---- sign-in -------------------------------------------------------------------
ARTHIK_USER=me
# bcrypt hash (preferred):  docker compose run --rm -it arthik hash-password
# Wrap it in single quotes so the $ signs survive.
ARTHIK_PASSWORD_HASH=
# ARTHIK_PASSWORD=change-me          # plain-text alternative
# Signs sessions:  openssl rand -hex 32
ARTHIK_SECRET=
# A sign-in lasts this long, unless the device was given the device key
# (sign-in screen or Settings → This device): then until you sign out.
# Changing the key signs those devices out.  openssl rand -hex 32
ARTHIK_SESSION_HOURS=12
ARTHIK_DEVICE_KEY=

# Lock-out: this many failed sign-ins (or wrong device keys) in a day ban the address
# from the whole site. Lift with: docker exec arthik arthik unban <ip|all>
ARTHIK_LOGIN_MAX_FAILS=5
ARTHIK_BAN_DAYS=30
# Never banned (comma-separated CIDRs), e.g. your home network. Empty = none.
ARTHIK_BAN_EXEMPT=
# Proxies whose CF-Connecting-IP / X-Forwarded-For are believed. Empty = private ranges.
# ARTHIK_TRUSTED_PROXIES=

# Optional read-only demo login with generated data, shown on the start page.
# Leave both empty for no demo.
ARTHIK_DEMO_USER=demouser
ARTHIK_DEMO_PASSWORD=demo

# ---- inbox (bank SMS from the phone, subscriptions from Kronos) -----------------
# Seconds between checks for edits made by other apps.
ARTHIK_WATCH_SECONDS=3
# Ignore source items older than this; forget reviewed drafts after KEEP days (> MAX_AGE).
ARTHIK_INBOX_MAX_AGE_DAYS=30
ARTHIK_INBOX_KEEP_DAYS=120
# A debit and a matching credit this many days apart become one transfer draft.
ARTHIK_INBOX_PAIR_DAYS=2
# Re-read inbox/ at least this often (minutes), even without a noticed change.
ARTHIK_INBOX_RESCAN_MINUTES=10

# Optional local AI (Ollama) that suggests categories for new merchants. Empty = off.
ARTHIK_AI_URL=
ARTHIK_AI_MODEL=
ARTHIK_AI_TIMEOUT_SECONDS=120
