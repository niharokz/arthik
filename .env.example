# Copy to .env and fill in. .env is gitignored — never commit it.

# ---- used by docker-compose (host side) ------------------------------------
# Folder on the host that holds the data files (the demo goes in <FINANCE_PATH>/demouser).
FINANCE_PATH=/path/to/notes/data/finance
# UID/GID that owns FINANCE_PATH (the container runs as this user).
PUID=1000
PGID=1000
# Time zone: decides what "today" is (future-dated transactions, SMS dates).
TZ=Asia/Kolkata

# ---- used by arthik ----------------------------------------------------------
# Your sign-in. The password may be plain text or a bcrypt hash from:
#   docker compose run --rm -it arthik hash-password
# (wrap a hash in single quotes so the $ signs are kept)
ARTHIK_USER=me
ARTHIK_PASSWORD=change-me
# Long random string that signs sessions (keeps you signed in across restarts):
#   openssl rand -hex 32
ARTHIK_SECRET=

# Read-only demo user with generated data. Its password is shown on the sign-in screen.
ARTHIK_DEMO=true
ARTHIK_DEMO_USER=demouser
ARTHIK_DEMO_PASSWORD=demo

# How often (seconds) to look for edits made to the data files by other apps
# (and for new SMS / Kronos files in <FINANCE_PATH>/inbox).
ARTHIK_WATCH_SECONDS=3

# ---- inbox (SMS from the phone app, subscriptions from Kronos) ---------------
# Ignore source items older than this many days; forget reviewed drafts after KEEP days
# (KEEP must be larger than MAX_AGE).
ARTHIK_INBOX_MAX_AGE_DAYS=30
ARTHIK_INBOX_KEEP_DAYS=120
# A bank debit and a matching credit on another of your accounts within this many
# days become one transfer draft (e.g. paying a card bill from savings).
ARTHIK_INBOX_PAIR_DAYS=2

# Optional local AI (Ollama) that suggests a category for merchants Arthik has never
# seen. Leave empty to switch it off. It only picks from your own categories.
# Arthik and Ollama must share a Docker network (both on "homelab" on nimory).
ARTHIK_AI_URL=
ARTHIK_AI_MODEL=
ARTHIK_AI_TIMEOUT_SECONDS=120
