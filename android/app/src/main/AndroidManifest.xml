<?xml version="1.0" encoding="utf-8"?>
<!-- Arthik for Android: a WebView shell around the Arthik engine running on the phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback sockets (WebView ↔ engine on 127.0.0.1) need this; nothing goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read/write the Syncthing folder by path (Android 11+: "All files access"). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Same, for Android 8–10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Fingerprint / face unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Nightly copy of bank SMS into the finance folder (switched on in Settings → Phone). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Run the copy at the chosen minute (optional; without it Android picks a time within ~15 min). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Set the nightly run and the morning notice again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Morning inbox notice (switched on in Settings → Phone; Android 13+ asks first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ArthikApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arthik">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".SmsAlarm" android:exported="false" />
        <receiver android:name=".NotifyAlarm" android:exported="false" />
        <receiver android:name=".Reschedule" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets: overview (4×2), budget, net worth and inbox (2×2). -->
        <receiver android:name=".ArthikWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".BudgetWidget" android:exported="true" android:label="Arthik budget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_budget_info" />
        </receiver>
        <receiver android:name=".NetWorthWidget" android:exported="true" android:label="Arthik net worth">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_networth_info" />
        </receiver>
        <receiver android:name=".InboxWidget" android:exported="true" android:label="Arthik inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_inbox_info" />
        </receiver>
    </application>
</manifest>
