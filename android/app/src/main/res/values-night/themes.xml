<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme: the WebView then reports prefers-color-scheme: dark. -->
<resources>
    <style name="Theme.Arthik" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/teal</item>
    </style>
</resources>
