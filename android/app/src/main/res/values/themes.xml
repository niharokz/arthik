<?xml version="1.0" encoding="utf-8"?>
<!-- Light theme: also tells the WebView the page should use prefers-color-scheme: light. -->
<resources>
    <style name="Theme.Arthik" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/teal</item>
    </style>
</resources>
