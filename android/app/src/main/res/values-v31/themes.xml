<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the system splash shows the icon's mark on a teal circle, then the
     app's own launch screen (same logo, same place) takes over. -->
<resources>
    <style name="Theme.Arthik" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/teal_icon</item>
    </style>
</resources>
